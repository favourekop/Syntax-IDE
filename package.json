{
  "name": "syntax-ide-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "SYNTAX IDE — Beyond the Code. Desktop edition.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:next\" \"npm:dev:electron\"",
    "dev:next": "next dev --hostname 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:3000 && electron .",
    "build:web": "next build",
    "build:desktop": "npm run build:web && electron-builder --win nsis",
    "build:desktop:dir": "npm run build:web && electron-builder --win dir",
    "start": "next start --hostname 127.0.0.1",
    "build": "npm run build:web"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.ekopdesignzhub.syntaxide",
    "productName": "SYNTAX IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      },
      {
        "from": ".next/static",
        "to": "app/.next/static"
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SYNTAX-IDE-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SYNTAX IDE"
    }
  }
}\n