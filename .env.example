# Copy to .env for local development. Never commit real credentials.
# Frontend-exposed Vite variables are public; do not put secret keys in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only: configure these in your hosting provider's secret variables.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DATABASE_ENCRYPTION_KEY=
